+
+        var scaled = (percent * 128 + 99) / 100;
+        if (scaled < 0x10) return @intCast(scaled);
+
+        // ceil(log2(scaled + 1)) is the bit length of `scaled`.
+        var x = scaled;
+        var ceil_log2: u6 = 0;

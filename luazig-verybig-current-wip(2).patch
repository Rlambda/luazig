diff --git a/tests/smoke/40_large_setlist_extraarg.lua b/tests/smoke/40_large_setlist_extraarg.lua
new file mode 100644
index 0000000..583b1df
--- /dev/null
+++ b/tests/smoke/40_large_setlist_extraarg.lua
@@ -0,0 +1,32 @@
+-- SETLIST stores its array offset in C until it outgrows one byte, then
+-- consumes the following EXTRAARG. Exercise both load() and dofile() so
+-- dynamically compiled text follows the bytecode VM path too.
+
+local parts = {"return {"}
+for i = 1, 700 do
+  parts[#parts + 1] = tostring(i)
+  parts[#parts + 1] = ","
+end
+parts[#parts + 1] = "}"
+
+local source = table.concat(parts)
+local loaded = assert(load(source, "=(large-setlist)"))
+local from_load = loaded()
+assert(#from_load == 700)
+assert(from_load[1] == 1 and from_load[256] == 256)
+assert(from_load[257] == 257 and from_load[700] == 700)
+
+local path = os.tmpname()
+assert(io.output(path))
+io.write("return {")
+for i = 1, 700 do io.write(i, ",") end
+io.write("}")
+assert(io.close())
+
+local from_file = assert(dofile(path))
+assert(os.remove(path))
+assert(#from_file == 700)
+assert(from_file[1] == 1 and from_file[256] == 256)
+assert(from_file[257] == 257 and from_file[700] == 700)
+
+print("large-setlist-extraarg-ok")
